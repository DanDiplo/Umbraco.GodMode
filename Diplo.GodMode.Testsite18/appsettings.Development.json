{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "AI": {
      "Analytics": {
        "Enabled": true
      },
      "AuditLog": {
        "Enabled": true
      }
    },
    "CMS": {
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://localhost:44358/"
      }
    }
  },
  "DiploGodModeTestsite": {
    "AllowHttpBackOffice": true
  },
  "Diplo": {
    "GodMode": {
      "AI": {
        "MaxOutputTokens": 4096
      }
    }
  }
}
