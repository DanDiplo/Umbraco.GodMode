<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;artifacts\**</DefaultItemExcludes>
    <CompressionEnabled>false</CompressionEnabled>
    <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <MinimalCompatibilityHost Condition="'$(MinimalCompatibilityHost)' == ''">false</MinimalCompatibilityHost>
    <UsePackedGodModePackage Condition="'$(UsePackedGodModePackage)' == ''">false</UsePackedGodModePackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Clean" Condition="'$(MinimalCompatibilityHost)' != 'true'" />
    <PackageReference Include="Umbraco.AI" />
    <PackageReference Include="Umbraco.AI.OpenAI" />
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
    <PackageReference Include="Umbraco.Community.Contentment" Condition="'$(MinimalCompatibilityHost)' != 'true'" />
    <PackageReference Include="Diplo.GodMode" Condition="'$(UsePackedGodModePackage)' == 'true'" />
    <PackageReference Include="Diplo.GodMode.AI" Condition="'$(UsePackedGodModePackage)' == 'true' And '$(GodModeAiPackageVersion)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>
  <Target Name="ValidatePackedGodModePackageConfiguration" BeforeTargets="CollectPackageReferences" Condition="'$(UsePackedGodModePackage)' == 'true'">
    <Error Condition="'$(GodModePackageVersion)' == ''" Text="Select a local v18 GodModePackageVersion in GodModePackage.local.props before enabling UsePackedGodModePackage." />
  </Target>
</Project>