<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <NoWarn>$(NoWarn);CS1591;CS8632</NoWarn>

    <Product>Diplo.GodMode</Product>
    <PackageId>Diplo.GodMode</PackageId>
    <Title>Diplo.GodMode</Title>
    <Description>Diplo God Mode makes Umbraco 17 developers invincible!</Description>
    <PackageTags>umbraco plugin package developer-tool umbraco-marketplace</PackageTags>
    <VersionPrefix>17.2.1</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <Authors>DanDiplo</Authors>
    <Company>$(Authors)</Company>
    <Copyright>Dan 'Diplo' Booth</Copyright>
    <PackageProjectUrl>https://github.com/DanDiplo/Umbraco.GodMode/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DanDiplo/Umbraco.GodMode/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Adds an Element Type Usage browser covering stored, configured, and nested inline block usage across SQL Server and SQLite, with detailed references, reliable occurrence counting, cache-bypassing reloads, and forward-compatible Umbraco 18 Library Item and Element Picker support.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Don't precompress: backoffice JS is shipped as-is -->
    <CompressionEnabled>false</CompressionEnabled>

    <!--
      Project our wwwroot at the virtual root rather than under
      _content/Diplo.GodMode/. Umbraco's plugin loader scans App_Plugins/<pkg>
      only two levels deep, so the manifest must surface at
      /App_Plugins/DiploGodMode/umbraco-package.json — not the RCL default of
      /_content/Diplo.GodMode/App_Plugins/DiploGodMode/...
    -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageReadmeFile>NuGet.md</PackageReadmeFile>
    <PackageIcon>GodModeIcon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Diplo.GodMode.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The Razor SDK auto-includes wwwroot\** as static web assets. When the host
    project (Diplo.GodMode.Testsite) ProjectReferences us, ASP.NET serves these files from
    /App_Plugins/DiploGodMode/... at runtime. `dotnet pack` ships them under
    staticwebassets/ in the .nupkg, so the package install path is identical.
  -->

  <!--
    Exclude the client source folder from compilation/content discovery, but
    surface the source umbraco-package.json + vite config in Solution Explorer
    for editing convenience. (Pack=false so they don't ship in the .nupkg —
    only the built wwwroot output does.)
  -->
  <ItemGroup>
    <Compile Remove="Client\**" />
    <Content Remove="Client\**" />
    <None Remove="Client\**" />
    <EmbeddedResource Remove="Client\**" />
    <None Include="..\Screenshots\Icon\GodModeIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\Screenshots\welcome.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\doc-type-browser.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\doc-type-browser-visual.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\datatypes.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\database-browser.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\diagnostics.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\services.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\log-browser.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\media-browser.png" Pack="true" PackagePath="screenshots\" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="Client\vite.config.ts" Pack="false" />
    <None Include="Client\tsconfig.json" Pack="false" />
    <None Include="Client\package.json" Pack="false" />
    <None Include="Client\src\**\*" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <None Update="NuGet.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="RestoreClientPackages" BeforeTargets="BuildClient" Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

  <Target Name="BuildClientForPack" BeforeTargets="Pack">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

</Project>

