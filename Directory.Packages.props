<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Defaults remain on v17. Isolated compatibility builds override these. -->
    <GodModeCmsVersion Condition="'$(GodModeCmsVersion)' == ''">[17.0.0,18.0.0)</GodModeCmsVersion>
    <GodModeAiCmsVersion Condition="'$(GodModeAiCmsVersion)' == ''">[17.3.0,18.0.0)</GodModeAiCmsVersion>
    <GodModeUmbracoAiVersion Condition="'$(GodModeUmbracoAiVersion)' == ''">1.10.1</GodModeUmbracoAiVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Clean" Version="7.0.5" />
    <PackageVersion Include="Umbraco.AI" Version="$(GodModeUmbracoAiVersion)" />
    <PackageVersion Include="Umbraco.AI.OpenAI" Version="1.2.0" />
    <PackageVersion Include="Umbraco.Cms" Version="17.4.2" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(GodModeCmsVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(GodModeCmsVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(GodModeCmsVersion)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="$(GodModeCmsVersion)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="$(GodModeCmsVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(GodModeCmsVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(GodModeCmsVersion)" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>
</Project>
