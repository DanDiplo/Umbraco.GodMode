<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <NoWarn>$(NoWarn);CS1591;CS8632</NoWarn>

    <Product>Diplo.GodMode.AI</Product>
    <PackageId>Diplo.GodMode.AI</PackageId>
    <Title>Diplo God Mode AI</Title>
    <Description>Optional Umbraco.AI companion package for Diplo.GodMode that adds contextual AI explanations to God Mode diagnostics and developer tools.</Description>
    <PackageTags>umbraco plugin package developer-tool ai umbraco-marketplace</PackageTags>
    <VersionPrefix>17.0.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <Authors>DanDiplo</Authors>
    <Company>$(Authors)</Company>
    <Copyright>Dan 'Diplo' Booth</Copyright>
    <PackageProjectUrl>https://github.com/DanDiplo/Umbraco.GodMode/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DanDiplo/Umbraco.GodMode/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Adds an overall scheduled-publishing health explanation using bounded evidence and snapshot-aware guidance. Version numbers now align with the supported Umbraco major: 17.x for Umbraco 17 and 18.x for Umbraco 18. Update the core package to the matching release. Includes guidance for structured AI response budgets and provider authentication.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <CompressionEnabled>false</CompressionEnabled>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageReadmeFile>NuGet.md</PackageReadmeFile>
    <PackageIcon>GodModeIcon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.AI" />
    <PackageReference Include="Umbraco.Cms.Api.Common" VersionOverride="$(GodModeAiCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" VersionOverride="$(GodModeAiCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Core" VersionOverride="$(GodModeAiCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" VersionOverride="$(GodModeAiCmsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diplo.GodMode\Diplo.GodMode.csproj" Condition="'$(GodModeCorePackageVersion)' == ''" />
    <!-- Release builds consume the inspected core NuGet with an explicit major boundary. -->
    <PackageReference Include="Diplo.GodMode" VersionOverride="$(GodModeCorePackageVersion)" Condition="'$(GodModeCorePackageVersion)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Client\**" />
    <Content Remove="Client\**" />
    <None Remove="Client\**" />
    <EmbeddedResource Remove="Client\**" />
    <None Include="..\Screenshots\Icon\GodModeIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\Screenshots\AI\AI-provider-setup.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\diagnostic-explain.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\log-analyser.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\log-error.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\datatype-explain.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\health-explain.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\key-value-explain.png" Pack="true" PackagePath="screenshots\" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="Client\vite.config.ts" Pack="false" />
    <None Include="Client\tsconfig.json" Pack="false" />
    <None Include="Client\package.json" Pack="false" />
    <None Include="Client\src\**\*" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <None Update="NuGet.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="RestoreClientPackages" BeforeTargets="BuildClient" Condition="'$(SkipFrontendBuild)' != 'true' And !Exists('$(MSBuildProjectDirectory)\Client\node_modules')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="PrepareForBuild" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

  <Target Name="BuildClientForPack" BeforeTargets="Pack" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

</Project>
