<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <NoWarn>$(NoWarn);CS1591;CS8632</NoWarn>

    <Product>Diplo.GodMode.AI</Product>
    <PackageId>Diplo.GodMode.AI</PackageId>
    <Title>Diplo God Mode AI</Title>
    <Description>Optional Umbraco.AI companion package for Diplo.GodMode that adds contextual AI explanations to God Mode diagnostics and developer tools.</Description>
    <PackageTags>umbraco plugin package developer-tool ai umbraco-marketplace</PackageTags>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <Authors>DanDiplo</Authors>
    <Company>$(Authors)</Company>
    <Copyright>Dan 'Diplo' Booth</Copyright>
    <PackageProjectUrl>https://github.com/DanDiplo/Umbraco.GodMode/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DanDiplo/Umbraco.GodMode/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Optional Umbraco.AI companion package for contextual God Mode explanations.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <CompressionEnabled>false</CompressionEnabled>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageReadmeFile>NuGet.md</PackageReadmeFile>
    <PackageIcon>GodModeIcon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.AI" />
    <PackageReference Include="Umbraco.Cms.Api.Common" VersionOverride="[17.3.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" VersionOverride="[17.3.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Core" VersionOverride="[17.3.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" VersionOverride="[17.3.0,18.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diplo.GodMode\Diplo.GodMode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Client\**" />
    <Content Remove="Client\**" />
    <None Remove="Client\**" />
    <EmbeddedResource Remove="Client\**" />
    <None Include="..\Screenshots\Icon\GodModeIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\Screenshots\AI\AI-provider-setup.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\diagnostic-explain.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\log-analyser.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\log-error.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\datatype-explain.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\health-explain.png" Pack="true" PackagePath="screenshots\" />
    <None Include="..\Screenshots\AI\key-value-explain.png" Pack="true" PackagePath="screenshots\" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="Client\vite.config.ts" Pack="false" />
    <None Include="Client\tsconfig.json" Pack="false" />
    <None Include="Client\package.json" Pack="false" />
    <None Include="Client\src\**\*" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <None Update="NuGet.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="RestoreClientPackages" BeforeTargets="BuildClient" Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

  <Target Name="BuildClientForPack" BeforeTargets="Pack">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

</Project>
